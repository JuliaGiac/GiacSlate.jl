# This file is a strict allowlist: everything is ignored, then tracked files are named
# back in one by one. A parent directory has to be un-ignored before anything inside it
# can be — git does not descend into an excluded directory — so the `# Directories`
# block below must stay ahead of the per-file blocks.
#
# Consequence worth knowing when adding files: a new source file is invisible to git
# until it is listed here.
*

# Root files
!/Project.toml
!/README.md
!/ROADMAP.md
!/UPSTREAM.md
!/CONTRIBUTORS.md
!/LICENSE
!/justfile
!/.gitignore

# Directories
!/src/
!/notebooks/
!/assets/
!/docs/
!/docs/src/
!/docs/src/assets/
!/.github/
!/.github/workflows/

# src/
!/src/GiacSlate.jl
!/src/grader.jl
!/src/inline_math.jl
!/src/laplace_lesson.jl
!/src/mathfield.jl

# notebooks/
# Project.toml pins the environment the notebooks are executed in, both by the `slate`
# CLI and by DocumenterSlate's isolated worker. Manifest.toml stays untracked.
!/notebooks/Project.toml
!/notebooks/Manifest.toml
!/notebooks/custom_controls.jl
!/notebooks/giac_intro.jl
!/notebooks/giac_tour.jl
!/notebooks/laplace_lesson.jl

# assets/
!/assets/importmap.js
!/assets/inline_math_editor.js
!/assets/mathcode.js
!/assets/mathfield.js

# docs/
# Deliberately still ignored, being build products: docs/build/, docs/slate_cache/,
# docs/Manifest.toml, docs/src/notebooks/ (generated from notebooks/ by DocumenterSlate)
# and docs/src/llms*.txt (generated by make.jl).
!/docs/Project.toml
!/docs/make.jl
!/docs/render.jl
!/docs/slate.toml
!/docs/slate_options.jl
!/docs/src/index.md
!/docs/src/getting-started.md
!/docs/src/math-input.md
!/docs/src/grading.md
!/docs/src/api.md
!/docs/src/notebooks.md
!/docs/src/assets/logo.svg
!/docs/src/assets/logo-dark.svg

# .github/
!/.github/workflows/docs.yml
